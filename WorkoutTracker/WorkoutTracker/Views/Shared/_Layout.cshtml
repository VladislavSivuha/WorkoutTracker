<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkoutTracker</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700;900&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/Core.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (ViewContext.RouteData.Values["action"]?.ToString() != "Authorization"
           && ViewContext.RouteData.Values["action"]?.ToString() != "Register")
    {
            <div class="dashboard-container">
                <aside class="left-sidebar">
                    <div>
                        <div class="sidebar-header d-flex align-items-center justify-content-between">
                            <div class="fw-bold font-mono text-uppercase u-fs-095" style="letter-spacing: 0.05em;">
                                [ТРЕКЕР]
                            </div>
                            <span class="badge-orange u-fs-065">DASHBOARD</span>
                        </div>

                        <div class="px-3 pt-3 pb-2 font-mono text-uppercase u-fs-068 u-color-muted" style="letter-spacing: 0.1em;">
                            НАВИГАЦИЯ
                        </div>

                        <nav>
                            <ul class="nav-menu">
                                <li>
                                    <a asp-controller="Statistics" asp-action="Statistics" class="nav-item-link">
                                        <span>.. // СТАТИСТИКА</span>
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Exercise" asp-action="Exercise" class="nav-item-link">
                                        <span>.. // УПРАЖНЕНИЯ</span>
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Template" asp-action="Template" class="nav-item-link">
                                        <span>.. // ШАБЛОНЫ</span>
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Workout" asp-action="Workout" class="nav-item-link">
                                        <span>.. // ТРЕНИРОВКИ</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>

                    <div class="sidebar-profile">
                        <div class="d-flex align-items-center gap-3">
                            <div class="avatar-square">ID</div>
                            <div class="font-mono" style="line-height: 1.2;">
                                <div class="fw-bold text-white text-uppercase u-fs-085">
                                @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "ATHLETE")
                                </div>
                                <div class="u-fs-072 u-color-accent" style="margin-top: 2px;">
                                    добавить что-то интересное
                                </div>
                            </div>
                        </div>

                        <form asp-controller="Authorization" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                            <button type="submit" class="btn-logout">← // ВЫЙТИ</button>
                        </form>
                    </div>
                </aside>

                <main class="main-viewport">
                    <div class="geometric-bg-grid"></div>
                    <div class="bg-shape-corner"></div>
                    <div class="bg-shape-stripe"></div>

                    <div class="content-layer">
                    @RenderBody()
                    </div>
                </main>
            </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>